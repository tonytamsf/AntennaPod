<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="de.danoeh.antennapod.permission.PLUGIN"/>

    <application
        android:allowBackup="true"
        android:label="AntennaPod Chapter Plugin">

        <service
            android:name=".ChapterPluginService"
            android:exported="true"
            android:permission="de.danoeh.antennapod.permission.PLUGIN">
            <intent-filter>
                <action android:name="de.danoeh.antennapod.plugin.action.MEDIA_PROCESSOR"/>
            </intent-filter>
            <meta-data
                android:name="de.danoeh.antennapod.plugin.ID"
                android:value="sample-chapters"/>
            <meta-data
                android:name="de.danoeh.antennapod.plugin.CAPABILITIES"
                android:value="2"/>
        </service>
    </application>
</manifest>
